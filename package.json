{
  "name": "panda",
  "version": "0.1.0",
  "description": "PANDA is a TypeScript intelligence runtime built around goals, dynamic capability routing, governed actions, and verified outcomes.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @panda/daemon --filter @panda/dashboard dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @panda/daemon start",
    "doctor": "pnpm --filter @panda/cli panda doctor",
    "generate:wallets": "node scripts/generate-wallets.js",
    "test": "pnpm -r test",
    "typecheck": "pnpm build && pnpm -r typecheck"
  },
  "keywords": [
    "agents",
    "framework",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@polkadot/util-crypto": "^14.0.3",
    "@polkadot/wasm-crypto": "^7.5.4",
    "@solana/web3.js": "^1.98.4",
    "bech32": "^2.0.0",
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.1",
    "ed25519-hd-key": "^2.0.0",
    "ethers": "^6.17.0",
    "ripple-keypairs": "^3.0.0",
    "tiny-secp256k1": "^2.2.4",
    "tronweb": "^6.4.0"
  },
  "devDependencies": {
    "@panda/sdk": "workspace:*",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
